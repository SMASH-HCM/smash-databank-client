# Copy these settings into your local .env; never commit that file.
# Use the Nextcloud server base URL, including any installation subdirectory.
NEXTCLOUD_URL=https://cloud.example.org
NEXTCLOUD_USERNAME=your-login-name
# Prefer a dedicated app password from Nextcloud > Personal settings > Security.
NEXTCLOUD_PASSWORD='your-app-password'
# Folder path as mounted in YOUR Nextcloud Files view (case-sensitive).
NEXTCLOUD_REMOTE_ROOT=databank
# Optional: paste the Files settings WebDAV URL if auto-discovery needs an override.
# This is usually https://cloud.example.org/remote.php/dav/files/your-login-name/
# NEXTCLOUD_WEBDAV_URL=
